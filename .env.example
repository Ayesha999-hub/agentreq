# Copy this file to .env and fill in ONE of the presets below.
# Never commit .env (it is in .gitignore). Any OpenAI-compatible API works.

# --- Groq (free tier) - the setup used for our results ----------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=PASTE_YOUR_KEY_HERE
LLM_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# --- Gemini (free tier) -----------------------------------------------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=PASTE_YOUR_KEY_HERE
# LLM_MODEL=gemini-2.0-flash

# --- OpenAI -----------------------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=PASTE_YOUR_KEY_HERE
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local, no key) -------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

# --- Optional: a DIFFERENT model as the judge (fairer scores) ---------
# Anything left out here falls back to the LLM_* values above.
# Groq's free tier has a daily token limit per model, so check yours first.
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=

# --- Offline stub for testing the code only (results are meaningless) -
# LLM_PROVIDER=mock
